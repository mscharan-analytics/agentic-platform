FROM node:20-alpine AS builder

WORKDIR /build

COPY src/web-ui/package.json src/web-ui/package-lock.json* ./
RUN npm ci

COPY src/web-ui/ ./
RUN npm run build

FROM node:20-alpine

WORKDIR /app

RUN npm install -g serve

COPY --from=builder /build/dist /app/dist

EXPOSE 3000

CMD ["serve", "-s", "dist", "-l", "3000"]
